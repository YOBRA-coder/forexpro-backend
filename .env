# ── Server ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Stripe (card payments — international users) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: create these as real Stripe Price IDs (Dashboard > Product catalog)
PRICE_TRADER_PRO=price_...
PRICE_TRADER_ELITE=price_...
PRICE_PROVIDER_BASIC=price_...
PRICE_PROVIDER_PRO=price_...

# ── M-Pesa Daraja (STK Push — Kenyan users) ──────────────────────────────────
MPESA_ENV=sandbox                # sandbox | production
MPESA_CONSUMER_KEY=...
MPESA_CONSUMER_SECRET=...
MPESA_SHORTCODE=174379           # your Paybill/Till number in production
MPESA_PASSKEY=...
MPESA_CALLBACK_URL=https://your-deployed-backend/payments/mpesa/callback

# ── Pricing (override defaults if you want) ──────────────────────────────────
REGISTRATION_FEE_USD=2.00
REGISTRATION_FEE_KES=250
